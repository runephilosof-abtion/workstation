#!/usr/bin/env bash
set -euo pipefail

NAME=${1:?usage: vm-ip <name>}
CONNECT=qemu:///system

IP=$(virsh --connect "$CONNECT" domifaddr "$NAME" \
  | awk '/ipv4/ { sub("/.*", "", $4); print $4; exit }')
[[ -n $IP ]] || { echo "No IP for '$NAME' (is it running?)" >&2; exit 1; }

CONF=$HOME/.ssh/dev-vms.d/$NAME.conf
[[ -f $CONF ]] && sed -i "s|^  HostName .*|  HostName $IP|" "$CONF"

echo "$IP"
