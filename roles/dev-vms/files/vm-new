#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: vm-new <name> [--mem MB] [--vcpus N] [--disk SIZE] [--nested]" >&2
  echo "                     [--repo URL] [--github-token-file PATH] [--copy-repos DIR]" >&2
  exit 1
}

NAME=${1:-}
[[ -n $NAME && $NAME != -* ]] || usage
shift

MEM=8192
VCPUS=4
DISK=30G
NESTED=0
REPO=
TOKEN_FILE=
COPY_REPOS=
while [[ $# -gt 0 ]]; do
  case $1 in
    --mem) MEM=$2; shift 2 ;;
    --vcpus) VCPUS=$2; shift 2 ;;
    --disk) DISK=$2; shift 2 ;;
    # Exposes host VMX/SVM to the guest so it can run its own nested KVM guests
    # (e.g. tests/run-integration-in-vm.sh, which needs a real libvirt inside).
    --nested) NESTED=1; shift ;;
    # Clone this repo on first boot via `gh repo clone`, authenticated with a
    # fine-grained PAT scoped to just that repo (see README).
    --repo) REPO=$2; shift 2 ;;
    --github-token-file) TOKEN_FILE=$2; shift 2 ;;
    # Once the VM is up, copy every git repo under DIR into it via vm-copy-repos.
    --copy-repos) COPY_REPOS=$2; shift 2 ;;
    *) usage ;;
  esac
done

CONNECT=${VM_CONNECT:-qemu:///system}
TEMPLATE=${VM_TEMPLATE:-/var/lib/libvirt/images/templates/debian-13-genericcloud-amd64.qcow2}
POOL=${VM_POOL:-/var/lib/libvirt/images/dev-vms}
KEY=$HOME/.ssh/dev-vm
NODE_MAJOR=${VM_NODE_MAJOR:-22}
ASDF_VERSION=${VM_ASDF_VERSION:-v0.20.2}
ASDF_NODEJS=${VM_ASDF_NODEJS:-24}
ASDF_PHP=${VM_ASDF_PHP:-8.5}
DISK_PATH=$POOL/$NAME.qcow2
SEED_PATH=$POOL/$NAME-seed.iso

[[ -e $DISK_PATH ]] && { echo "VM disk $DISK_PATH already exists" >&2; exit 1; }
[[ -z $COPY_REPOS || -d $COPY_REPOS ]] || { echo "--copy-repos: no such directory: $COPY_REPOS" >&2; exit 1; }

# The VM commits as you, but with its own SSH key and GPG signing key generated
# inside it on first boot (see vm-git-setup below), so nothing on the host has
# to be shared and revoking those keys on GitHub cuts the VM off.
GIT_NAME=$(git config --global user.name || true)
GIT_EMAIL=$(git config --global user.email || true)
[[ -n $GIT_NAME && -n $GIT_EMAIL ]] || echo "note: no git user.name/user.email on host; the VM gets an SSH key but no git identity or GPG signing key" >&2

# Long-lived Claude Code OAuth token (from `claude setup-token`) so the VM comes
# up already logged in under your Claude.ai plan (not billed as separate API
# usage). Not a copy of ~/.claude/.credentials.json: its refresh token rotates,
# so whichever of host and VM refreshed second got logged out. This puts the
# token inside a VM meant to contain hostile code; treat it as within this
# VM's blast radius, same as the GitHub PAT below.
CLAUDE_TOKEN_FILE=${VM_CLAUDE_TOKEN:-$HOME/.config/dev-vms/claude.token}
CLAUDE_TOKEN=
if [[ -f $CLAUDE_TOKEN_FILE ]]; then
  CLAUDE_TOKEN=$(<"$CLAUDE_TOKEN_FILE")
else
  echo "note: no $CLAUDE_TOKEN_FILE on host; Claude Code will need \`claude\` login run manually inside the VM" >&2
  echo "      (to skip that next time: claude setup-token, then save the token there, chmod 600)" >&2
fi

# Composer credentials (e.g. Satispress) for private packages; within the VM's
# blast radius like the Claude token above. Follows the host's COMPOSER_HOME:
# with asdf's PHP and COMPOSER_HOME unset, Composer keeps auth.json inside the
# PHP install (~/.asdf/installs/php/<version>/.composer), not ~/.config/composer.
COMPOSER_AUTH_FILE=${VM_COMPOSER_AUTH:-${COMPOSER_HOME:-$HOME/.config/composer}/auth.json}
[[ -f $COMPOSER_AUTH_FILE ]] || echo "note: no $COMPOSER_AUTH_FILE on host; private Composer repositories (e.g. Satispress) won't authenticate inside the VM" >&2

GITHUB_TOKEN=
REPO_DIR=
if [[ -n $REPO ]]; then
  TOKEN_FILE=${TOKEN_FILE:-$HOME/.config/dev-vms/tokens/$NAME.token}
  if [[ ! -f $TOKEN_FILE ]]; then
    echo "no GitHub token at $TOKEN_FILE" >&2
    echo "create a fine-grained PAT scoped to just $REPO (github.com Settings >" >&2
    echo "Developer settings > Fine-grained tokens, repository access: only" >&2
    echo "$REPO, permission: Contents), then:" >&2
    echo "  mkdir -p $(dirname "$TOKEN_FILE") && chmod 700 $(dirname "$TOKEN_FILE")" >&2
    echo "  echo YOUR_TOKEN > $TOKEN_FILE && chmod 600 $TOKEN_FILE" >&2
    exit 1
  fi
  GITHUB_TOKEN=$(<"$TOKEN_FILE")
  REPO_DIR=$(basename "$REPO" .git)
fi

qemu-img create -q -f qcow2 -b "$TEMPLATE" -F qcow2 "$DISK_PATH" "$DISK"

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
cat > "$WORK/user-data" <<EOF
#cloud-config
hostname: $NAME
users:
  - name: dev
    groups: sudo
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - $(cat "$KEY.pub")
# The nwfilter attached below blocks direct internet HTTP/HTTPS — everything must go through
# the host's squid proxy instead. write_files runs before package_update/packages/runcmd, so
# apt (and the nodesource curl step) can already reach it.
write_files:
  - path: /etc/apt/apt.conf.d/95proxy
    content: |
      Acquire::http::Proxy "http://192.168.122.1:3128";
      Acquire::https::Proxy "http://192.168.122.1:3128";
  - path: /etc/environment
    append: true
    content: |
      http_proxy=http://192.168.122.1:3128
      https_proxy=http://192.168.122.1:3128
      HTTP_PROXY=http://192.168.122.1:3128
      HTTPS_PROXY=http://192.168.122.1:3128
      no_proxy=localhost,127.0.0.1
      # asdf-php points an unset COMPOSER_HOME into the PHP install, which would
      # hide the auth.json copied here and lose it on every PHP upgrade. Set here
      # rather than in a profile script so non-interactive ssh commands get it too.
      COMPOSER_HOME=/home/dev/.config/composer
  # dockerd is a systemd service, so it sees neither /etc/environment nor apt's
  # proxy; without this, image pulls hit the nwfilter directly and fail.
  - path: /etc/systemd/system/docker.service.d/http-proxy.conf
    content: |
      [Service]
      Environment="HTTP_PROXY=http://192.168.122.1:3128" "HTTPS_PROXY=http://192.168.122.1:3128" "NO_PROXY=localhost,127.0.0.1"
EOF

# asdf manages the per-project node/php versions (.tool-versions).
cat >> "$WORK/user-data" <<'EOF'
  - path: /etc/profile.d/asdf.sh
    content: |
      case ":$PATH:" in
        *":${ASDF_DATA_DIR:-$HOME/.asdf}/shims:"*) ;;
        *) export PATH="${ASDF_DATA_DIR:-$HOME/.asdf}/shims:$PATH" ;;
      esac
  - path: /usr/local/bin/asdf-install-defaults
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      # Installs the newest Node.js and PHP matching the given prefixes and makes
      # them the user's defaults (~/.tool-versions).
      # Usage: asdf-install-defaults <nodejs prefix> <php prefix>, e.g. 24 8.5
      set -euo pipefail
      plugins=$(asdf plugin list 2>/dev/null || true)
      grep -qx nodejs <<<"$plugins" || asdf plugin add nodejs https://github.com/asdf-vm/asdf-nodejs.git
      grep -qx php <<<"$plugins" || asdf plugin add php https://github.com/asdf-community/asdf-php.git
      nodejs=$(asdf latest nodejs "$1")
      php=$(asdf latest php "$2")
      asdf install nodejs "$nodejs"
      # The plugin fetches Composer's installer with PHP's copy(), which ignores
      # http(s)_proxy and so is blocked by the nwfilter. When that fails it falls
      # back to a composer-setup.php already in the working directory, still
      # checking its signature. PEAR is skipped: pear.php.net isn't allowed.
      work=$(mktemp -d)
      curl -fsSL https://getcomposer.org/installer -o "$work/composer-setup.php"
      (cd "$work" && PHP_WITHOUT_PEAR=yes ASDF_CONCURRENCY=$(nproc) asdf install php "$php")
      rm -rf "$work"
      asdf set -u nodejs "$nodejs"
      asdf set -u php "$php"
EOF

# /etc/environment, like COMPOSER_HOME above, so it reaches non-interactive ssh
# commands and the VS Code extension too.
if [[ -n $CLAUDE_TOKEN ]]; then
  cat >> "$WORK/user-data" <<EOF
  - path: /etc/environment
    append: true
    content: |
      CLAUDE_CODE_OAUTH_TOKEN=$CLAUDE_TOKEN
EOF
fi

# Files under /home/dev must be deferred: plain write_files runs before
# users_groups creates the dev user, so it would create /home/dev as root and
# useradd would leave it that way (breaking e.g. VS Code's ~/.vscode-server).
if [[ -f $COMPOSER_AUTH_FILE ]]; then
  cat >> "$WORK/user-data" <<EOF
  - path: /home/dev/.config/composer/auth.json
    defer: true
    owner: dev:dev
    permissions: '0600'
    encoding: b64
    content: $(base64 -w0 "$COMPOSER_AUTH_FILE")
EOF
fi

if [[ -n $REPO ]]; then
  cat >> "$WORK/user-data" <<EOF
  - path: /home/dev/.github-token
    defer: true
    owner: dev:dev
    permissions: '0600'
    encoding: b64
    content: $(printf '%s' "$GITHUB_TOKEN" | base64 -w0)
EOF
fi

# No passphrases: the AI uses these keys unattended, and an unlocked agent is
# as usable to it as an unencrypted key. Revoking them on GitHub is the control.
{
  printf '#!/bin/bash\nset -euo pipefail\n'
  printf 'VM_NAME=%q GIT_NAME=%q GIT_EMAIL=%q\n' "$NAME" "$GIT_NAME" "$GIT_EMAIL"
  cat <<'EOF'
[[ -f ~/.ssh/id_ed25519 ]] || ssh-keygen -q -t ed25519 -N '' -C "dev@$VM_NAME" -f ~/.ssh/id_ed25519
ssh-keyscan -t ed25519 github.com >> ~/.ssh/known_hosts 2>/dev/null || true
[[ -n $GIT_NAME && -n $GIT_EMAIL ]] || exit 0
git config --global user.name "$GIT_NAME"
git config --global user.email "$GIT_EMAIL"
# A per-VM identity and a 1-year expiry, so its signatures are recognisable as
# the VM's and the key stops working on its own if forgotten.
UID_STR="$GIT_NAME ($VM_NAME) <$GIT_EMAIL>"
gpg --batch --pinentry-mode loopback --passphrase '' --quick-gen-key "$UID_STR" ed25519 sign 1y
FPR=$(gpg --list-secret-keys --with-colons "$UID_STR" | awk -F: '/^fpr/ { print $10; exit }')
git config --global user.signingkey "$FPR"
git config --global commit.gpgsign true
git config --global tag.gpgsign true
EOF
} > "$WORK/vm-git-setup"

cat >> "$WORK/user-data" <<EOF
  - path: /usr/local/bin/vm-git-setup
    permissions: '0755'
    encoding: b64
    content: $(base64 -w0 "$WORK/vm-git-setup")
package_update: true
packages:
  - git
  - gnupg
  - curl
  - ca-certificates
  - build-essential
  # asdf-php compiles PHP from source
  - autoconf
  - bison
  - re2c
  - pkg-config
  - plocate
  - libcurl4-openssl-dev
  - libedit-dev
  - libgd-dev
  - libicu-dev
  - libjpeg-dev
  - default-libmysqlclient-dev
  - libonig-dev
  - libpng-dev
  - libpq-dev
  - libreadline-dev
  - libsqlite3-dev
  - libssl-dev
  - libxml2-dev
  - libzip-dev
  - zlib1g-dev
  # Debian's docker-compose also ships the "docker compose" CLI plugin.
  - docker.io
  - docker-compose
runcmd:
  - usermod -aG docker dev
  - su - dev -c vm-git-setup
  - export http_proxy=http://192.168.122.1:3128 https_proxy=http://192.168.122.1:3128
  - curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash -
  - apt-get install -y nodejs
  # Native installer as dev, into ~/.local, so Claude can update itself; an
  # npm -g install as root leaves it unable to.
  - su - dev -c 'curl -fsSL https://claude.ai/install.sh | bash'
  - ln -sf /home/dev/.local/bin/claude /usr/local/bin/claude
  - curl -fsSL https://github.com/asdf-vm/asdf/releases/download/${ASDF_VERSION}/asdf-${ASDF_VERSION}-linux-amd64.tar.gz | tar -xz -C /usr/local/bin asdf
  - echo '. /etc/profile.d/asdf.sh' >> /etc/bash.bashrc
  - su - dev -c 'asdf-install-defaults ${ASDF_NODEJS} ${ASDF_PHP}'
EOF

# write_files creates the parent directories root-owned.
[[ -f $COMPOSER_AUTH_FILE ]] && cat >> "$WORK/user-data" <<EOF
  - chown -R dev:dev /home/dev/.config
EOF

if [[ -n $REPO ]]; then
  cat >> "$WORK/user-data" <<EOF
  - curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg -o /usr/share/keyrings/githubcli-archive-keyring.gpg
  - chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg
  - echo "deb [arch=amd64 signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list
  - apt-get update
  - apt-get install -y gh
  - su - dev -c 'gh auth login --with-token < /home/dev/.github-token'
  - su - dev -c 'gh auth setup-git'
  - rm -f /home/dev/.github-token
  - su - dev -c "gh repo clone $REPO /home/dev/work/$REPO_DIR"
EOF
fi

cloud-localds "$SEED_PATH" "$WORK/user-data"
# Best-effort: the seed ISO now carries copied secrets (Claude OAuth token,
# GitHub PAT). libvirt's storage driver may re-chown/re-mode this on first use
# (observed 0644 libvirt-qemu:libvirt-qemu on this host), so this isn't a firm
# guarantee -- verify on a new host rather than relying on it.
chmod 600 "$SEED_PATH"

# q35: the genericcloud image ships no IDE driver, so the seed cdrom must not
# land on the i440fx default's IDE bus; q35 gives it SATA. UEFI: trixie amd64
# cloud images no longer boot via BIOS.
CPU_ARGS=()
[[ $NESTED == 1 ]] && CPU_ARGS=(--cpu host-passthrough)
virt-install \
  --connect "$CONNECT" \
  --machine q35 \
  --name "$NAME" \
  --memory "$MEM" \
  --vcpus "$VCPUS" \
  "${CPU_ARGS[@]}" \
  --disk "path=$DISK_PATH,format=qcow2,bus=virtio" \
  --disk "path=$SEED_PATH,device=cdrom" \
  --osinfo detect=on,require=off \
  --boot uefi \
  --import \
  --network network=default,model=virtio,filterref.filter=vm-egress-lockdown \
  --graphics none \
  --noautoconsole

echo "Waiting for IP address..."
IP=
for _ in $(seq 60); do
  IP=$(virsh --connect "$CONNECT" domifaddr --domain "$NAME" \
    | awk '/ipv4/ { sub("/.*", "", $4); print $4; exit }')
  [[ -n $IP ]] && break
  sleep 2
done
[[ -n $IP ]] || { echo "Timed out waiting for an IP; check: virsh --connect $CONNECT domifaddr $NAME" >&2; exit 1; }

mkdir -p "$HOME/.ssh/dev-vms.d"
cat > "$HOME/.ssh/dev-vms.d/$NAME.conf" <<EOF
Host $NAME
  HostName $IP
  User dev
  IdentityFile $KEY
  StrictHostKeyChecking accept-new
EOF

echo "VM '$NAME' is up at $IP — connect with: ssh $NAME (or VSCode Remote-SSH)"
echo "cloud-init may still be installing packages; wait with: ssh $NAME cloud-init status --wait"

if command -v code >/dev/null 2>&1; then
  echo "Installing the Claude Code extension over Remote-SSH..."
  CODE_OK=0
  for _ in $(seq 30); do
    if code --remote "ssh-remote+$NAME" --install-extension anthropic.claude-code >/dev/null 2>&1; then
      CODE_OK=1
      break
    fi
    sleep 5
  done
  if [[ $CODE_OK == 1 ]]; then
    echo "Claude Code extension installed."
  else
    echo "warning: extension install didn't succeed yet (VM may still be booting sshd);" >&2
    echo "         retry manually: code --remote ssh-remote+$NAME --install-extension anthropic.claude-code" >&2
  fi
else
  echo "note: 'code' CLI not on PATH; install the Claude Code extension manually via Remote-SSH" >&2
  echo "      (VS Code: Cmd/Ctrl+Shift+P > Shell Command: Install 'code' command in PATH, to enable this next time)" >&2
fi

echo "Print the VM's own SSH and GPG public keys, to add on GitHub: vm-keys $NAME"

if [[ -n $COPY_REPOS ]]; then
  echo "Waiting for cloud-init before copying repos from $COPY_REPOS..."
  SSH_OK=0
  for _ in $(seq 30); do
    if ssh -o ConnectTimeout=5 "$NAME" true; then
      SSH_OK=1
      break
    fi
    sleep 5
  done
  [[ $SSH_OK == 1 ]] || { echo "couldn't reach $NAME over ssh; copy later with: vm-copy-repos $NAME $COPY_REPOS" >&2; exit 1; }
  ssh "$NAME" cloud-init status --wait >/dev/null || echo "warning: cloud-init reported errors; check: ssh $NAME cloud-init status --long" >&2
  "$(dirname "$0")/vm-copy-repos" "$NAME" "$COPY_REPOS"
fi
