#!/usr/bin/env bash
set -euo pipefail

CONNECT=${VM_CONNECT:-qemu:///system}

mapfile -t NAMES < <(virsh --connect "$CONNECT" list --all --name | sed '/^$/d')

if [[ ${#NAMES[@]} -eq 0 ]]; then
  echo "No VMs."
  exit 0
fi

printf '%-20s %-10s %s\n' NAME STATE IP
for NAME in "${NAMES[@]}"; do
  STATE=$(virsh --connect "$CONNECT" domstate --domain "$NAME")
  IP=-
  if [[ $STATE == running ]]; then
    FOUND=$(virsh --connect "$CONNECT" domifaddr --domain "$NAME" \
      | awk '/ipv4/ { sub("/.*", "", $4); print $4; exit }')
    [[ -n $FOUND ]] && IP=$FOUND
  fi
  printf '%-20s %-10s %s\n' "$NAME" "$STATE" "$IP"
done
